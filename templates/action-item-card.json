{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.4",
  "body": [
    { "type": "TextBlock", "text": "MinuteMate: a new action item for you", "weight": "Bolder", "size": "Medium" },
    { "type": "TextBlock", "text": "${Title}", "wrap": true, "size": "Large", "weight": "Bolder" },
    {
      "type": "FactSet",
      "facts": [
        { "title": "Project", "value": "${ProjectName}" },
        { "title": "Due", "value": "${DueText}" },
        { "title": "Priority", "value": "${Priority}" }
      ]
    },
    { "type": "TextBlock", "text": "${Details}", "wrap": true, "spacing": "Medium" }
  ],
  "actions": [
    { "type": "Action.OpenUrl", "title": "Open action item", "url": "${ItemLink}" }
  ]
}
